PARSER_BEGIN(Lugosi)
import java.io.*;
public class Lugosi {

  public static void main(String args[]) throws IOException {
    if (args.length == 0) {
      System.err.println("Uso: java Lugosi arquivo.lug");
      return;
    }
    try {
      Lugosi analisadorSintatico = new Lugosi(new FileInputStream(args[0]));
      analisadorSintatico.Lugosi();
      System.out.println("An\u00e1lise sint\u00e1tica conclu\u00edda: nenhum erro encontrado.");
    } catch (ParseException e) {
      System.err.println("Erro sint\u00e1tico: " + e.getMessage());
      System.exit(1);
    }
  }

}

PARSER_END(Lugosi)

SKIP :
{
  " "
| "\t"
| "\n"
| "\r"
}

/* Palavras reservadas da Linguagem Lugosi */
TOKEN :
{
  <MAIN: "main">
| <VAR: "var">
| <INT: "int">
| <BOOL: "bool">
| <IF: "if">
| <WHILE: "while">
| <DO: "do">
| <RETURN: "return">
| <PRINT: "print">
| <FUNCTION: "function">
| <TRUE: "true">
| <FALSE: "false">
}

/* Operadores e simbolos da Linguagem Lugosi */
TOKEN :
{
  <ATRIBUICAO: ":=">
| <IGUALDADE: "==">
| <AND: "&&">
| <OR: "||">
| <ACHAVES: "{">
| <FCHAVES: "}">
| <APARENTESES: "(">
| <FPARENTESES: ")">
| <SEMI: ";">
| <VIRGULA: ",">
| <SUM: "+">
| <SUB: "-">
| <MULT: "*">
| <DIV: "/">
| <MENOR: "<">
| <MAIOR: ">">
}

/* Convencoes lexicas do enunciado:
     TOKEN_numliteral -> digitos fracao_opcional expoente_opcional
     TOKEN_id         -> letra letraoudigito* finalsublinhado*      */
TOKEN :
{
  <NUM : (["0"-"9"])+ ("." (["0"-"9"])+)? (["e","E"] ("+"|"-")? (["0"-"9"])+)?>
 |< ID: ["a"-"z","A"-"Z"] ( ["a"-"z","A"-"Z","0"-"9"])* ( "_" (["a"-"z","A"-"Z","0"-"9"])+ )*>
}

/**************************************************************************************************
 * Trabalho 2 - Analisador Sintatico da Linguagem Lugosi
 *
 * Gramatica do enunciado, com a recursao a esquerda eliminada (JavaCC nao aceita
 * recursao a esquerda nem alternativas iniciadas pelo mesmo simbolo):
 *
 *   LUGOSI      -> MAIN FUNC*
 *   MAIN        -> "main" "{" VARDECL SEQCOMANDOS "}"
 *   VARDECL     -> ( "var" TIPO TOKEN_id ";" )*            [era: VARDECL "var" ... | vazio]
 *   TIPO        -> "int" | "bool"
 *   SEQCOMANDOS -> COMANDO*                                 [era: SEQCOMANDOS COMANDO | vazio]
 *   COMANDO     -> TOKEN_id ":=" EXP ";"
 *                | TOKEN_id "(" LISTAEXP? ")" ";"
 *                | "if" "(" EXP ")" "{" SEQCOMANDOS "}" ";"
 *                | "while" "(" EXP ")" "do" "{" SEQCOMANDOS "}" ";"
 *                | "do" "{" SEQCOMANDOS "}" "while" "(" EXP ")" ";"
 *                | "return" EXP ";"
 *                | "print" "(" EXP ")" ";"
 *   EXP         -> "(" EXP OP EXP ")" | FATOR
 *   FATOR       -> TOKEN_id ( "(" LISTAEXP? ")" )? | TOKEN_numliteral | "true" | "false"
 *   OP          -> "+" | "-" | "*" | "/" | "&&" | "||" | "<" | ">" | "=="
 *   LISTAEXP    -> EXP ( "," EXP )*                        [era: LISTAEXP "," EXP]
 *   FUNC        -> ( "function" TIPO TOKEN_id "(" LISTAARG? ")"
 *                    "{" VARDECL SEQCOMANDOS "}" )*        [era: FUNC ... | ...]
 *   LISTAARG    -> TIPO TOKEN_id ( "," TIPO TOKEN_id )*    [era: LISTAARG "," ...]
 *
 * As duas alternativas de COMANDO que comecam por TOKEN_id sao distinguidas pelo
 * segundo simbolo (":=" ou "("), resolvido pelo lookahead do JavaCC.
 **************************************************************************************************/

/* LUGOSI -> MAIN FUNC* */
void Lugosi () :
{
}
{
  Main()
  ( Funcion() )*
  <EOF>
}

/* MAIN -> "main" "{" VARDECL SEQCOMANDOS "}" */
void Main () :
{
}
{
  <MAIN> <ACHAVES> VarDecl() SeqComandos() <FCHAVES>
}

/* VARDECL -> ( "var" TIPO TOKEN_id ";" )* */
void VarDecl () :
{
}
{
  ( <VAR> Tipo() <ID> <SEMI> )*
}

/* TIPO -> "int" | "bool" */
void Tipo () :
{
}
{
  <INT>
| <BOOL>
}

/* SEQCOMANDOS -> COMANDO* */
void SeqComandos () :
{
}
{
  ( Comando() )*
}

/* COMANDO -> atribuicao | chamada | if | while | do-while | return | print */
void Comando () :
{
}
{
  <ID>
  (
    <ATRIBUICAO> Exp() <SEMI>
  | <APARENTESES> ( ListaExp() )? <FPARENTESES> <SEMI>
  )
| <IF> <APARENTESES> Exp() <FPARENTESES> <ACHAVES> SeqComandos() <FCHAVES> <SEMI>
| <WHILE> <APARENTESES> Exp() <FPARENTESES> <DO> <ACHAVES> SeqComandos() <FCHAVES> <SEMI>
| <DO> <ACHAVES> SeqComandos() <FCHAVES> <WHILE> <APARENTESES> Exp() <FPARENTESES> <SEMI>
| <RETURN> Exp() <SEMI>
| <PRINT> <APARENTESES> Exp() <FPARENTESES> <SEMI>
}

/* EXP -> "(" EXP OP EXP ")" | FATOR */
void Exp () :
{
}
{
  <APARENTESES> Exp() Op() Exp() <FPARENTESES>
| Fator()
}

/* FATOR -> TOKEN_id ( "(" LISTAEXP? ")" )? | TOKEN_numliteral | "true" | "false" */
void Fator () :
{
}
{
  <ID> ( <APARENTESES> ( ListaExp() )? <FPARENTESES> )?
| <NUM>
| <TRUE>
| <FALSE>
}

/* OP -> "+" | "-" | "*" | "/" | "&&" | "||" | "<" | ">" | "==" */
void Op () :
{
}
{
  <SUM>
| <SUB>
| <MULT>
| <DIV>
| <AND>
| <OR>
| <MENOR>
| <MAIOR>
| <IGUALDADE>
}

/* LISTAEXP -> EXP ( "," EXP )* */
void ListaExp () :
{
}
{
  Exp() ( <VIRGULA> Exp() )*
}

/* FUNC -> ( "function" TIPO TOKEN_id "(" LISTAARG? ")" "{" VARDECL SEQCOMANDOS "}" )* */
void Funcion () :
{
}
{
  <FUNCTION> Tipo() <ID> <APARENTESES> ( ListaArg() )? <FPARENTESES>
  <ACHAVES> VarDecl() SeqComandos() <FCHAVES>
}

/* LISTAARG -> TIPO TOKEN_id ( "," TIPO TOKEN_id )* */
void ListaArg () :
{
}
{
  Tipo() <ID> ( <VIRGULA> Tipo() <ID> )*
}

PARSER_BEGIN(Lugosi)
import java.io.*;
public class Lugosi {

  public static void main(String args[]) throws ParseException,IOException {
    if (args.length == 0) {
      System.err.println("Uso: java Lugosi arquivo.lug");
      return;
    }
    Lugosi analisadorLexico  = new Lugosi(new FileInputStream(args[0]));
    analisadorLexico.Lugosi();
  }

}

PARSER_END(Lugosi)

SKIP :
{
  " "
| "\t"
| "\n"
| "\r"
}

/* Palavras reservadas da Linguagem Lugosi */
TOKEN :
{
  <MAIN: "main">
| <VAR: "var">
| <INT: "int">
| <BOOL: "bool">
| <IF: "if">
| <WHILE: "while">
| <DO: "do">
| <RETURN: "return">
| <PRINT: "print">
| <FUNCTION: "function">
| <TRUE: "true">
| <FALSE: "false">
}

/* Operadores e simbolos da Linguagem Lugosi */
TOKEN :
{
  <ATRIBUICAO: ":=">
| <IGUALDADE: "==">
| <AND: "&&">
| <OR: "||">
| <ACHAVES: "{">
| <FCHAVES: "}">
| <APARENTESES: "(">
| <FPARENTESES: ")">
| <SEMI: ";">
| <VIRGULA: ",">
| <SUM: "+">
| <SUB: "-">
| <MULT: "*">
| <DIV: "/">
| <MENOR: "<">
| <MAIOR: ">">
}

/* Convencoes lexicas do enunciado:
     TOKEN_numliteral -> digitos fracao_opcional expoente_opcional
     TOKEN_id         -> letra letraoudigito* finalsublinhado*      */
TOKEN :
{
  <NUM : (["0"-"9"])+ ("." (["0"-"9"])+)? (["e","E"] ("+"|"-")? (["0"-"9"])+)?>
 |< ID: ["a"-"z","A"-"Z"] ( ["a"-"z","A"-"Z","0"-"9"])* ( "_" (["a"-"z","A"-"Z","0"-"9"])+ )*>
}

void Lugosi () :
{Token t;}
{

(
  <MAIN> { System.out.println("Palavra reservada: main");}
| <VAR> { System.out.println("Palavra reservada: var");}
| <INT> { System.out.println("Palavra reservada: int");}
| <BOOL> { System.out.println("Palavra reservada: bool");}
| <IF> { System.out.println("Palavra reservada: if");}
| <WHILE> { System.out.println("Palavra reservada: while");}
| <DO> { System.out.println("Palavra reservada: do");}
| <RETURN> { System.out.println("Palavra reservada: return");}
| <PRINT> { System.out.println("Palavra reservada: print");}
| <FUNCTION> { System.out.println("Palavra reservada: function");}
| <TRUE> { System.out.println("Valor l\u00f3gico: true");}
| <FALSE> { System.out.println("Valor l\u00f3gico: false");}
| <ATRIBUICAO> { System.out.println("Atribui\u00e7\u00e3o: :=");}
| <IGUALDADE> { System.out.println("Igualdade: ==");}
| <AND> { System.out.println("E l\u00f3gico: &&");}
| <OR> { System.out.println("Ou l\u00f3gico: ||");}
| <ACHAVES> { System.out.println("Abre Chaves: {");}
| <FCHAVES> { System.out.println("Fecha Chaves: }");}
| <APARENTESES> { System.out.println("Abre par\u00eanteses: (");}
| <FPARENTESES> { System.out.println("Fecha par\u00eanteses: )");}
| <SEMI> { System.out.println("Ponto e v\u00edrgula: ;");}
| <VIRGULA> { System.out.println("V\u00edrgula: ,");}
| <SUM> { System.out.println("Soma: +");}
| <SUB> { System.out.println("Subtra\u00e7\u00e3o: -");}
| <MULT> { System.out.println("Multiplica\u00e7\u00e3o: *");}
| <DIV> { System.out.println("Divis\u00e3o: /");}
| <MENOR> { System.out.println("Menor que: <");}
| <MAIOR> { System.out.println("Maior que: >");}
| t=<NUM> { System.out.println("N\u00famero: "+ t.image);}
| t=<ID> { System.out.println("Identificador: "+ t.image);}

)*
<EOF>

}
options {
  STATIC = false;
}

PARSER_BEGIN(Lugosi)
import java.io.*;
import java.util.*;
public class Lugosi {

  private final StringBuilder mainBody = new StringBuilder();
  private final StringBuilder functions = new StringBuilder();
  private StringBuilder output;
  private int indent;
  private boolean wroteLine;

  private void line(String text) {
    for (int i = 0; i < indent; i++) {
      output.append("    ");
    }
    output.append(text).append('\n');
    wroteLine = true;
  }

  private String pythonType(String type) {
    return "bool".equals(type) ? "bool" : "int";
  }

  private String defaultValue(String type) {
    return "bool".equals(type) ? "False" : "0";
  }

  private void emitBlockHeader(String header) {
    line(header + ":");
    indent++;
    wroteLine = false;
  }

  private void emitPassIfEmpty() {
    if (!wroteLine) {
      line("pass");
    }
  }

  private String generatedProgram() {
    StringBuilder result = new StringBuilder();
    result.append(functions);
    result.append("def main():\n");
    if (mainBody.length() == 0) {
      result.append("    pass\n");
    } else {
      result.append(mainBody);
    }
    result.append("\nif __name__ == \"__main__\":\n");
    result.append("    main()\n");
    return result.toString();
  }

  public static void main(String args[]) throws IOException {
    if (args.length == 0) {
      System.err.println("Uso: java Lugosi arquivo.lug [saida.py]");
      return;
    }
    try {
      Lugosi analisadorSintatico = new Lugosi(new FileInputStream(args[0]));
      analisadorSintatico.Lugosi();
      String outputFile = args.length > 1
          ? args[1]
          : args[0].replaceFirst("\\.[^.]*$", "") + ".py";
      Writer writer = new OutputStreamWriter(new FileOutputStream(outputFile), "UTF-8");
      writer.write(analisadorSintatico.generatedProgram());
      writer.close();
      System.out.println("Compilação concluída: " + outputFile);
    } catch (ParseException e) {
      System.err.println("Erro sint\u00e1tico: " + e.getMessage());
      System.exit(1);
    } catch (TokenMgrError e) {
      System.err.println("Erro l\u00e9xico: " + e.getMessage());
      System.exit(1);
    }
  }
}

PARSER_END(Lugosi)

SKIP :
{
  " "
| "\t"
| "\n"
| "\r"
}

/* Palavras reservadas da Linguagem Lugosi */
TOKEN :
{
  <MAIN: "main">
| <VAR: "var">
| <INT: "int">
| <BOOL: "bool">
| <IF: "if">
| <WHILE: "while">
| <DO: "do">
| <RETURN: "return">
| <PRINT: "print">
| <FUNCTION: "function">
| <TRUE: "true">
| <FALSE: "false">
}

/* Operadores e simbolos da Linguagem Lugosi */
TOKEN :
{
  <ATRIBUICAO: ":=">
| <IGUALDADE: "==">
| <AND: "&&">
| <OR: "||">
| <ACHAVES: "{">
| <FCHAVES: "}">
| <APARENTESES: "(">
| <FPARENTESES: ")">
| <SEMI: ";">
| <VIRGULA: ",">
| <SUM: "+">
| <SUB: "-">
| <MULT: "*">
| <DIV: "/">
| <MENOR: "<">
| <MAIOR: ">">
}

/* Convencoes lexicas do enunciado:
     TOKEN_numliteral -> digitos fracao_opcional expoente_opcional
     TOKEN_id         -> letra letraoudigito* finalsublinhado*      */
TOKEN :
{
  <NUM : (["0"-"9"])+ ("." (["0"-"9"])+)? (["e","E"] ("+"|"-")? (["0"-"9"])+)?>
 |< ID: ["a"-"z","A"-"Z"] ( ["a"-"z","A"-"Z","0"-"9"])* ( "_" (["a"-"z","A"-"Z","0"-"9"])+ )*>
}

/**************************************************************************************************
 * Trabalho 2 - Analisador Sintatico da Linguagem Lugosi
 *
 * Gramatica do enunciado, com a recursao a esquerda eliminada (JavaCC nao aceita
 * recursao a esquerda nem alternativas iniciadas pelo mesmo simbolo):
 *
 *   LUGOSI      -> MAIN FUNC*
 *   MAIN        -> "main" "{" VARDECL SEQCOMANDOS "}"
 *   VARDECL     -> ( "var" TIPO TOKEN_id ";" )*            [era: VARDECL "var" ... | vazio]
 *   TIPO        -> "int" | "bool"
 *   SEQCOMANDOS -> COMANDO*                                 [era: SEQCOMANDOS COMANDO | vazio]
 *   COMANDO     -> TOKEN_id ":=" EXP ";"
 *                | TOKEN_id "(" LISTAEXP? ")" ";"
 *                | "if" "(" EXP ")" "{" SEQCOMANDOS "}" ";"
 *                | "while" "(" EXP ")" "do" "{" SEQCOMANDOS "}" ";"
 *                | "do" "{" SEQCOMANDOS "}" "while" "(" EXP ")" ";"
 *                | "return" EXP ";"
 *                | "print" "(" EXP ")" ";"
 *   EXP         -> "(" EXP OP EXP ")" | FATOR
 *   FATOR       -> TOKEN_id ( "(" LISTAEXP? ")" )? | TOKEN_numliteral | "true" | "false"
 *   OP          -> "+" | "-" | "*" | "/" | "&&" | "||" | "<" | ">" | "=="
 *   LISTAEXP    -> EXP ( "," EXP )*                        [era: LISTAEXP "," EXP]
 *   FUNC        -> ( "function" TIPO TOKEN_id "(" LISTAARG? ")"
 *                    "{" VARDECL SEQCOMANDOS "}" )*        [era: FUNC ... | ...]
 *   LISTAARG    -> TIPO TOKEN_id ( "," TIPO TOKEN_id )*    [era: LISTAARG "," ...]
 *
 * As duas alternativas de COMANDO que comecam por TOKEN_id sao distinguidas pelo
 * segundo simbolo (":=" ou "("), resolvido pelo lookahead do JavaCC.
 **************************************************************************************************/

/* LUGOSI -> MAIN FUNC* */
void Lugosi () :
{
}
{
  Main()
  ( Funcion() )*
  <EOF>
}

/* MAIN -> "main" "{" VARDECL SEQCOMANDOS "}" */
void Main () :
{
}
{
  {
    output = mainBody;
    indent = 1;
    wroteLine = false;
  }
  <MAIN> <ACHAVES> VarDecl() SeqComandos() <FCHAVES>
}

/* VARDECL -> ( "var" TIPO TOKEN_id ";" )* */
void VarDecl () :
{
  String type;
  Token name;
}
{
  (
    <VAR> type=Tipo() name=<ID> <SEMI>
    {
      line(name.image + " = " + defaultValue(type));
    }
  )*
}

/* TIPO -> "int" | "bool" */
String Tipo () :
{
}
{
  <INT> { return "int"; }
| <BOOL> { return "bool"; }
}

/* SEQCOMANDOS -> COMANDO* */
void SeqComandos () :
{
}
{
  ( Comando() )*
}

/* COMANDO -> atribuicao | chamada | if | while | do-while | return | print */
void Comando () :
{
  Token name;
  String expression;
  String condition;
  String arguments = null;
}
{
  name=<ID>
  (
    <ATRIBUICAO> expression=Exp() <SEMI>
    {
      line(name.image + " = " + expression);
    }
  | <APARENTESES> ( arguments=ListaExp() )? <FPARENTESES> <SEMI>
    {
      line(name.image + "(" + (arguments == null ? "" : arguments) + ")");
    }
  )
| <IF> <APARENTESES> condition=Exp() <FPARENTESES> <ACHAVES>
  {
    emitBlockHeader("if " + condition);
  }
  SeqComandos()
  {
    emitPassIfEmpty();
    indent--;
  }
  <FCHAVES> <SEMI>
| <WHILE> <APARENTESES> condition=Exp() <FPARENTESES> <DO> <ACHAVES>
  {
    emitBlockHeader("while " + condition);
  }
  SeqComandos()
  {
    emitPassIfEmpty();
    indent--;
  }
  <FCHAVES> <SEMI>
| <DO> <ACHAVES>
  {
    emitBlockHeader("while True");
  }
  SeqComandos()
  {
    emitPassIfEmpty();
  }
  <FCHAVES> <WHILE> <APARENTESES> condition=Exp() <FPARENTESES>
  {
    line("if not (" + condition + "):");
    indent++;
    line("break");
    indent--;
    indent--;
  }
  <SEMI>
| <RETURN> expression=Exp() <SEMI>
  {
    line("return " + expression);
  }
| <PRINT> <APARENTESES> expression=Exp() <FPARENTESES> <SEMI>
  {
    line("print(" + expression + ")");
  }
}

/* EXP -> "(" EXP OP EXP ")" | FATOR */
String Exp () :
{
  String left;
  String operator;
  String right;
}
{
  <APARENTESES> left=Exp() operator=Op() right=Exp() <FPARENTESES>
  {
    if ("&&".equals(operator)) operator = "and";
    else if ("||".equals(operator)) operator = "or";
    return "(" + left + " " + operator + " " + right + ")";
  }
| left=Fator() { return left; }
}

/* FATOR -> TOKEN_id ( "(" LISTAEXP? ")" )? | TOKEN_numliteral | "true" | "false" */
String Fator () :
{
  Token name;
  Token number;
  String arguments = null;
}
{
  name=<ID>
  (
    <APARENTESES> ( arguments=ListaExp() )? <FPARENTESES>
    {
      return name.image + "(" + (arguments == null ? "" : arguments) + ")";
    }
  )?
  {
    return name.image;
  }
| number=<NUM> { return number.image; }
| <TRUE> { return "True"; }
| <FALSE> { return "False"; }
}

/* OP -> "+" | "-" | "*" | "/" | "&&" | "||" | "<" | ">" | "==" */
String Op () :
{
}
{
  <SUM> { return "+"; }
| <SUB> { return "-"; }
| <MULT> { return "*"; }
| <DIV> { return "/"; }
| <AND> { return "&&"; }
| <OR> { return "||"; }
| <MENOR> { return "<"; }
| <MAIOR> { return ">"; }
| <IGUALDADE> { return "=="; }
}

/* LISTAEXP -> EXP ( "," EXP )* */
String ListaExp () :
{
  String first;
  String next;
  StringBuilder result;
}
{
  {
    result = new StringBuilder();
  }
  first=Exp() { result.append(first); }
  ( <VIRGULA> next=Exp() { result.append(", ").append(next); } )*
  {
    return result.toString();
  }
}

/* FUNC -> ( "function" TIPO TOKEN_id "(" LISTAARG? ")" "{" VARDECL SEQCOMANDOS "}" )* */
void Funcion () :
{
  String returnType;
  Token name;
  List<String> parameters;
  StringBuilder previousOutput;
  int previousIndent;
  boolean previousWroteLine;
}
{
  <FUNCTION> returnType=Tipo() name=<ID> <APARENTESES>
  {
    parameters = new ArrayList<String>();
  }
  ( parameters=ListaArg() )? <FPARENTESES>
  {
    previousOutput = output;
    previousIndent = indent;
    previousWroteLine = wroteLine;
    output = functions;
    indent = 0;
    wroteLine = false;
    StringBuilder header = new StringBuilder("def ");
    header.append(name.image).append("(");
    for (int i = 0; i < parameters.size(); i++) {
      if (i > 0) header.append(", ");
      header.append(parameters.get(i));
    }
    header.append(")");
    emitBlockHeader(header.toString());
  }
  <ACHAVES> VarDecl() SeqComandos() <FCHAVES>
  {
    emitPassIfEmpty();
    indent--;
    output = previousOutput;
    indent = previousIndent;
    wroteLine = previousWroteLine;
  }
}

/* LISTAARG -> TIPO TOKEN_id ( "," TIPO TOKEN_id )* */
List<String> ListaArg () :
{
  String type;
  Token name;
  List<String> result;
}
{
  {
    result = new ArrayList<String>();
  }
  type=Tipo() name=<ID>
  {
    result.add(name.image);
  }
  ( <VIRGULA> type=Tipo() name=<ID>
    {
      result.add(name.image);
    }
  )*
  {
    return result;
  }
}
